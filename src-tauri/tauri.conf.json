{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hells Factory Studio",
  "version": "0.1.0",
  "identifier": "studio.hellsfactory.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hell's Factory Studio",
        "width": 1500,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Subtitle translation & QA studio",
    "publisher": "Hell's Factory",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "languages": [
          "Thai",
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}